def run_audit(
    evidence,
    diagnosis,
    review_result,
    verification_result,
    phase7_result
):

    print()
    print("=" * 60)
    print("              PHASE 6 AUDIT")
    print("=" * 60)

    audit_directory = os.path.join(
        BASE_DIR,
        "data"
    )

    os.makedirs(
        audit_directory,
        exist_ok=True
    )

    audit_file = os.path.join(
        audit_directory,
        "responsible_ai_log.json"
    )

    record = {
        "timestamp": datetime.now().isoformat(),
        "phase": 7,
        "case_id": diagnosis.get(
            "case_id",
            "UNKNOWN"
        ),
        "diagnosis": diagnosis.get(
            "title",
            "Unknown"
        ),
        "match_score": diagnosis.get(
            "match_score",
            0
        ),
        "human_review": review_result,
        "verification": verification_result,
        "phase7": {
            "confidence": phase7_result.get(
                "confidence",
                {}
            ),
            "decision_status": phase7_result.get(
                "decision_status",
                "UNKNOWN"
            )
        },
        "automatic_configuration_applied": False
    }

    records = []

    if os.path.exists(audit_file):

        try:

            with open(
                audit_file,
                "r",
                encoding="utf-8"
            ) as file:

                existing = json.load(file)

                if isinstance(existing, list):
                    records = existing

        except Exception:

            records = []

    records.append(record)

    with open(
        audit_file,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            records,
            file,
            indent=4
        )

    print()
    print("Audit record saved successfully.")

    print()
    print("Audit file:")
    print(audit_file)

    return record


