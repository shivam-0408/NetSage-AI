def normalize_text(value):

    if value is None:
        return ""

    if isinstance(value, (dict, list)):
        value = json.dumps(value)

    return str(value).lower()


def calculate_case_similarity(evidence_text, case):

    text = normalize_text(evidence_text)

    score = 0

    # Problem
    problem = case.get("problem", "")

    for word in normalize_text(problem).split():

        if len(word) > 3 and word in text:
            score += 1

    # Symptoms
    for symptom in case.get("symptoms", []):

        matches = 0

        for word in normalize_text(symptom).split():

            if len(word) > 3 and word in text:
                matches += 1

        if matches >= 2:
            score += 3

    # Show commands
    for command_name, command_output in case.get(
        "show_commands", {}
    ).items():

        matches = 0

        for word in normalize_text(command_output).split():

            if len(word) > 3 and word in text:
                matches += 1

        if matches >= 2:
            score += 4

    return score


def build_evidence_graph(evidence, diagnosis):

    nodes = []
    relationships = []
    supporting = []
    contradictions = []

    # --------------------------------------------------------
    # Ping evidence
    # --------------------------------------------------------

    for ping in evidence.get("pings", []):

        destination = ping.get("destination", "unknown")
        status = ping.get("status", "unknown")
        loss = ping.get("loss_percentage", 0)

        node = {
            "type": "ping",
            "destination": destination,
            "status": status,
            "loss": loss
        }

        nodes.append(node)

        if status.lower() != "success":

            supporting.append(
                f"Ping failure detected for {destination}"
            )

        if loss == 0:

            relationships.append(
                f"{destination} is reachable"
            )

    # --------------------------------------------------------
    # Interface evidence
    # --------------------------------------------------------

    for interface in evidence.get("interfaces", []):

        name = interface.get("interface", "")
        status = interface.get("status", "")
        protocol = interface.get("protocol", "")

        nodes.append({
            "type": "interface",
            "interface": name,
            "status": status,
            "protocol": protocol
        })

        if "administratively down" in status.lower():

            supporting.append(
                f"{name} is administratively down"
            )

        if status.lower() == "up" and protocol.lower() == "up":

            relationships.append(
                f"{name} is operationally up"
            )

    # --------------------------------------------------------
    # VLAN evidence
    # --------------------------------------------------------

    for vlan in evidence.get("vlans", []):

        vlan_id = vlan.get("vlan_id", "")
        status = vlan.get("status", "")

        nodes.append({
            "type": "vlan",
            "vlan_id": vlan_id,
            "status": status
        })

        if str(status).lower() == "active":

            supporting.append(
                f"VLAN {vlan_id} is active"
            )

    # --------------------------------------------------------
    # Trunk evidence
    # --------------------------------------------------------

    trunk = evidence.get("trunk", {})

    if trunk.get("is_trunk"):

        nodes.append({
            "type": "trunk",
            "ports": trunk.get("ports", []),
            "allowed_vlans": trunk.get("allowed_vlans", ""),
            "active_vlans": trunk.get("active_vlans", "")
        })

        relationships.append(
            "Active trunk detected"
        )

        active_vlans = str(
            trunk.get("active_vlans", "")
        )

        if "30" in active_vlans:

            supporting.append(
                "VLAN 30 is active on the trunk"
            )

    # --------------------------------------------------------
    # Diagnosis relationship
    # --------------------------------------------------------

    if diagnosis:

        nodes.append({
            "type": "diagnosis",
            "case_id": diagnosis.get("case_id", "UNKNOWN")
        })

        relationships.append(
            "Network evidence supports selected diagnosis"
        )

    return {
        "nodes": nodes,
        "relationships": relationships,
        "supporting_evidence": supporting,
        "contradictions": contradictions
    }


def calculate_phase7_confidence(
    selected_score,
    competing_scores,
    graph
):

    # --------------------------------------------------------
    # Match strength
    # --------------------------------------------------------

    if selected_score <= 0:

        match_strength = 0

    else:

        match_strength = min(
            100,
            round(
                selected_score /
                max(selected_score, 1) *
                92
            )
        )

    # --------------------------------------------------------
    # Evidence strength
    # --------------------------------------------------------

    supporting = len(
        graph.get("supporting_evidence", [])
    )

    contradictions = len(
        graph.get("contradictions", [])
    )

    evidence_strength = min(
        100,
        40 + (supporting * 10) - (contradictions * 15)
    )

    evidence_strength = max(
        0,
        evidence_strength
    )

    # --------------------------------------------------------
    # Diagnostic separation
    # --------------------------------------------------------

    if len(competing_scores) <= 1:

        separation = 100

    else:

        ordered = sorted(
            competing_scores,
            reverse=True
        )

        first = ordered[0]
        second = ordered[1]

        if first == 0:

            separation = 0

        else:

            separation = round(
                ((first - second) / first) * 100
            )

    separation = max(
        0,
        min(100, separation)
    )

    # --------------------------------------------------------
    # Contradiction penalty
    # --------------------------------------------------------

    contradiction_penalty = min(
        30,
        contradictions * 10
    )

    # --------------------------------------------------------
    # Overall confidence
    # --------------------------------------------------------

    overall = round(
        (
            match_strength * 0.40
            +
            evidence_strength * 0.40
            +
            separation * 0.20
        )
        - contradiction_penalty
    )

    overall = max(
        0,
        min(100, overall)
    )

    if overall >= 80:

        level = "HIGH"

    elif overall >= 60:

        level = "MODERATE"

    else:

        level = "LOW"

    return {
        "overall": overall,
        "level": level,
        "match_strength": match_strength,
        "evidence_strength": evidence_strength,
        "diagnostic_separation": separation,
        "supporting_evidence": supporting,
        "exclusion_evidence": len(
            graph.get("relationships", [])
        ),
        "contradicting_evidence": contradictions,
        "contradiction_penalty": contradiction_penalty
    }


def run_phase7_decision(
    evidence,
    diagnosis,
    cases,
    selected_score
):

    print()
    print("=" * 60)
    print("              PHASE 7 DECISION INTELLIGENCE")
    print("=" * 60)

    # --------------------------------------------------------
    # Convert evidence to searchable text
    # --------------------------------------------------------

    evidence_text = json.dumps(
        evidence,
        default=str
    )

    # --------------------------------------------------------
    # Score all cases
    # --------------------------------------------------------

    case_results = []

    for case in cases:

        score = calculate_case_similarity(
            evidence_text,
            case
        )

        case_results.append({
            "case": case,
            "score": score
        })

    case_results.sort(
        key=lambda item: item["score"],
        reverse=True
    )

    # --------------------------------------------------------
    # Build graph
    # --------------------------------------------------------

    graph = build_evidence_graph(
        evidence,
        diagnosis
    )

    # --------------------------------------------------------
    # Confidence
    # --------------------------------------------------------

    competing_scores = [
        item["score"]
        for item in case_results
    ]

    confidence = calculate_phase7_confidence(
        selected_score,
        competing_scores,
        graph
    )

    # --------------------------------------------------------
    # Selected diagnosis
    # --------------------------------------------------------

    selected_id = diagnosis.get(
        "case_id",
        "UNKNOWN"
    )

    selected_title = diagnosis.get(
        "title",
        "Unknown Case"
    )

    print()
    print("NetSage AI Decision Intelligence")
    print("-" * 50)

    print(
        f"Selected Case: "
        f"{selected_id} - {selected_title}"
    )

    print(
        f"Match Score: {selected_score}"
    )

    print(
        f"Overall Confidence: "
        f"{confidence['overall']}% "
        f"({confidence['level']})"
    )

    # --------------------------------------------------------
    # Why selected
    # --------------------------------------------------------

    print()
    print("Why this case was selected:")

    for item in diagnosis.get(
        "matching_evidence",
        []
    ):

        print(f"- {item}")

    if not diagnosis.get("matching_evidence"):

        for item in graph[
            "supporting_evidence"
        ]:

            print(f"- {item}")

    # --------------------------------------------------------
    # Evidence Graph
    # --------------------------------------------------------

    print()
    print("Evidence Graph:")

    print(
        f"- Nodes: {len(graph['nodes'])}"
    )

    print(
        f"- Relationships: "
        f"{len(graph['relationships'])}"
    )

    print(
        f"- Supporting evidence: "
        f"{len(graph['supporting_evidence'])}"
    )

    print(
        f"- Contradictions: "
        f"{len(graph['contradictions'])}"
    )

    # --------------------------------------------------------
    # Confidence breakdown
    # --------------------------------------------------------

    print()
    print("Confidence Breakdown:")

    print(
        f"- Match Strength: "
        f"{confidence['match_strength']}%"
    )

    print(
        f"- Evidence Strength: "
        f"{confidence['evidence_strength']}%"
    )

    print(
        f"- Diagnostic Separation: "
        f"{confidence['diagnostic_separation']}%"
    )

    print(
        f"- Supporting Evidence: "
        f"{confidence['supporting_evidence']}"
    )

    print(
        f"- Exclusion Evidence: "
        f"{confidence['exclusion_evidence']}"
    )

    print(
        f"- Contradicting Evidence: "
        f"{confidence['contradicting_evidence']}"
    )

    # --------------------------------------------------------
    # Competing diagnoses
    # --------------------------------------------------------

    print()
    print("Competing Diagnoses:")

    for index, item in enumerate(
        case_results[:5],
        start=1
    ):

        case = item["case"]

        case_id = case.get(
            "case_id",
            case.get("id", "UNKNOWN")
        )

        title = case.get(
            "title",
            case.get("name", "Unknown Case")
        )

        # Approximate competitor confidence
        competitor_score = item["score"]

        if selected_score > 0:

            competitor_confidence = round(
                min(
                    99,
                    (
                        competitor_score /
                        selected_score
                    ) * confidence["overall"]
                )
            )

        else:

            competitor_confidence = 0

        print(
            f"{index}. "
            f"{case_id} - {title} "
            f"(score={competitor_score}, "
            f"confidence={competitor_confidence}%)"
        )

    print()
    print("-" * 60)

    # --------------------------------------------------------
    # Decision status
    # --------------------------------------------------------

    if confidence["overall"] >= 80:

        decision_status = (
            "HIGH-CONFIDENCE DIAGNOSIS"
        )

    elif confidence["overall"] >= 60:

        decision_status = (
            "MODERATE-CONFIDENCE DIAGNOSIS"
        )

    else:

        decision_status = (
            "LOW-CONFIDENCE DIAGNOSIS"
        )

    print(
        f"Decision Status: {decision_status}"
    )

    print(
        "Human approval remains required."
    )

    return {
        "phase": 7,
        "selected_case": selected_id,
        "selected_title": selected_title,
        "match_score": selected_score,
        "confidence": confidence,
        "evidence_graph": graph,
        "competing_diagnoses": case_results,
        "decision_status": decision_status,
        "timestamp": datetime.now().isoformat()
    }


